#include <iostream>
#include <algorithm> // Required for std::equal
#include <cassert>   // Required for the assert macro
#include <vector>    // Required for defining expected results easily

using namespace std;

void mergeArrays(int arr[], int l, int m, int r) {
    int n1 = m - l + 1;
    int n2 = r - m;

    int *L = new int[n1];
    int *R = new int[n2];

    for (int i = 0; i < n1; i++) L[i] = arr[l + i];
    for (int i = 0; i < n2; i++) R[i] = arr[m + 1 + i];

    int i = 0, j = 0, k = l;

    while (i < n1 && j < n2) {
        if (L[i] <= R[j]) arr[k++] = L[i++];
        else arr[k++] = R[j++];
    }

    while (i < n1) arr[k++] = L[i++];
    while (j < n2) arr[k++] = R[j++];

    delete[] L;
    delete[] R;
}

void multiPhaseMergeSort(int arr[], int n) {
    int size = 1;

    while (size < n) {
        int left = 0;

        while (left < n) {
            int mid = left + size - 1;
            int right = left + 2 * size - 1;

            if (mid >= n) break;
            if (right >= n) right = n - 1;

            mergeArrays(arr, left, mid, right);
            left += 2 * size;
        }

        size *= 2;
    }
}

// Helper functions and unit tests

bool arraysEqual(int arr1[], const vector<int>& arr2) {
    if (arr2.empty() && arr2.size() == 0) return true;
    return equal(arr1, arr1 + arr2.size(), arr2.begin());
}

// Set of for the Merge Sort functions.
 
void runTests() {
    cout << "### Running Unit Tests ###" << endl;

    //  Tests for mergeArrays (The Merge Function)
    cout << "Testing mergeArrays..." << endl;

    int arr1[] = {1, 3, 5, 2, 4, 6};
    vector<int> expected1 = {1, 2, 3, 4, 5, 6};
    mergeArrays(arr1, 0, 2, 5); 
    assert(arraysEqual(arr1, expected1) && "Test 1: Basic merge");

    int arr2[] = {5, 8, 8, 5, 9, 9};
    vector<int> expected2 = {5, 5, 8, 8, 9, 9};
    mergeArrays(arr2, 0, 2, 5); 
    assert(arraysEqual(arr2, expected2) && "Test 2: Merge with duplicates");

    int arr3[] = {1, 2, 10, 11};
    vector<int> expected3 = {1, 2, 10, 11};
    mergeArrays(arr3, 0, 1, 3); 
    assert(arraysEqual(arr3, expected3) && "Test 3: Left array finishes first");

    int arr4[] = {10, 11, 1, 2};
    vector<int> expected4 = {1, 2, 10, 11};
    mergeArrays(arr4, 0, 1, 3); 
    assert(arraysEqual(arr4, expected4) && "Test 4: Right array finishes first");

    int arr5[] = {99, 10, 30, 20, 40, 0};
    vector<int> expected5 = {99, 10, 20, 30, 40, 0};
    mergeArrays(arr5, 1, 2, 4); 
    assert(arraysEqual(arr5, expected5) && "Test 5: Merge inner subarrays");
    
    cout << "mergeArrays: 5 tests passed." << endl;
    cout << endl; 

int main() {
    runTests(); 
    return 0;
}
